@using Du_An_Ecomerce.ViewModel
@model LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container-fluid py-5">
    <div class="container py-5">
        <h1 class="mb-4">Đăng nhập</h1>
        <form asp-action="DangNhap" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <div class="text-danger" asp-asp-validation-summary="All"></div>
            <div class="row">
                <div class="col-md-12 col-lg-6">
                    <div class="form-item w-100">
                        <label asp-for="@Model.Username" class="form-label my-3"><sup>*</sup></label>
                        <input asp-for="@Model.Username" type="text" class="form-control">
                        <span asp-validation-for="@Model.Username" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 col-lg-6">
                    <div class="form-item w-100">
                        <label asp-for="@Model.Password" class="form-label my-3"><sup>*</sup></label>
                        <input asp-for="@Model.Password" class="form-control">
                        <span asp-validation-for="@Model.Password" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row g-4 text-center align-items-center justify-content-center pt-4">
                <button type="submit" class="btn border-secondary py-3 px-4 text-uppercase w-100 text-primary">
                    Đăng nhập</button>
                </div>
                <a asp-action="DangKy" asp-controller="KhachHang">Chưa có tài khoản? Đăng ký ngay</a>
                <a asp-action="QuenMatKhau" asp-controller="KhachHang">Quên mật khẩu?</a>
            </form>
        </div>
    </div>