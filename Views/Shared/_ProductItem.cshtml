@using Du_An_Ecomerce.ViewModel
@model ProductViewModel

<div class="col-md-6 col-lg-6 col-xl-4">
    <div class="rounded position-relative fruite-item">
        <div class="fruite-img">
            <a aps-action="Detail" asp-controller="HangHoa" asp-route-id="@Model.MaSanPham"
               class="text-decoration-none text-dark">
                <img src="~/Hinh/HangHoa/@Model.HinhAnh" class="img-fluid w-100 rounded-top" alt="@Model.TenSanPham">
            </a>
        </div>
        <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">
            @Model.TenLoai</div>
            <div class="p-4 border border-secondary border-top-0 rounded-bottom">
                <a aps-action="Detail" asp-controller="HangHoa" asp-route-id="@Model.MaSanPham"
                   class="text-decoration-none text-dark">
                    <h4>@Model.TenSanPham</h4>
                </a>
                <p>@Model.MoTaNgan</p>
                <div class="d-flex justify-content-between flex-lg-wrap">
                    <p class="text-dark fs-5 fw-bold mb-0">$@Model.GiaBan / kg</p>
                    <a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@Model.MaSanPham"
                       class="btn border border-secondary rounded-pill px-3 text-primary"><i
                        class="fa fa-shopping-bag me-2 text-primary"></i>Thêm vào giỏ
                        hàng</a>
                    </div>
                </div>
            </div>
        </div>